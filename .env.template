# Environment Configuration Template
# Copy this file to .env and update paths for your system
# .env is gitignored and won't be committed

# Java JVM Path
# Windows: C:\Program Files\Java\jdk-XX\bin\server\jvm.dll
# Linux: /usr/lib/jvm/java-XX-openjdk/lib/server/libjvm.so
# macOS: /Library/Java/JavaVirtualMachines/jdkXX.jdk/Contents/Home/lib/server/libjvm.dylib
JVM_PATH=C:\Program Files\Java\jdk-23\bin\server\jvm.dll

# Project directory (absolute path to this repository)
PROJECT_DIR=D:\programming\python\Quantum-satellites-simulator

# Orekit data directory
OREKIT_DATA_PATH=D:\programming\python\Quantum-satellites-simulator\orekit-data\orekit-data-main

# Simulation parameters
SIM_START_TIME=2025-11-09T12:00:00Z
SIM_TIME_STEP=1.0
SIM_SPEED_MULTIPLIER=1.0

# Orbital elements (default: 700km Sun-synchronous orbit)
ORBIT_ALTITUDE_KM=700
ORBIT_ECCENTRICITY=0.0
ORBIT_INCLINATION_DEG=98.0
ORBIT_RAAN_DEG=10.0
ORBIT_ARG_PERIGEE_DEG=0.0
ORBIT_MEAN_ANOMALY_DEG=0.0

# Logging
LOG_TELEMETRY=true
LOG_EVENTS=true
TELEMETRY_FILE=data/telemetry.csv
EVENTS_FILE=data/events.json

# CZML Configuration
CZML_OUTPUT_FILE=cubesat_with_events.czml
CZML_VIEWER_FILE=czml_viewer_enhanced.html
CZML_DEFAULT_DURATION_SECONDS=3600

# Streaming
ENABLE_STREAMING=false
WEBSOCKET_HOST=localhost
WEBSOCKET_PORT=8080
